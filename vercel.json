{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "web/**,src/**,config.yaml"
    }
  },
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|svg|ico|webm|wav|mp3))",
      "dest": "/web/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web/static/index.html"
    }
  ]
}