{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "web/**,src/**,config.yaml"
    }
  },
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/evaluate",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/web/static/$1"
    }
  ]
}