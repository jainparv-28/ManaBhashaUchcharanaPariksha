{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{web/**,src/**,config.yaml,data/reference_texts/**,audios_for_pronunciation_test/audios_teachers/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" },
    {
      "src": "/uploads/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|svg|ico|webm|wav|mp3))",
      "dest": "/web/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web/static/index.html"
    }
  ]
}